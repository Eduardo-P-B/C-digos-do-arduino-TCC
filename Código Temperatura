#include <OneWire.h>
#include <DallasTemperature.h>

// Pino de dados conectado ao pino digital 2 do Arduino
const int pinoDados = 2;

OneWire oneWire(pinoDados);

DallasTemperature sensores(&oneWire);

void setup() {
  Serial.begin(9600);
  sensores.begin(); // Inicializa o sensor
}

void loop() {
  sensores.requestTemperatures(); 
  float temperaturaC = sensores.getTempCByIndex(0); 
  Serial.print("Temperatura: ");
  Serial.print(temperaturaC);
  Serial.println(" °C");
}
